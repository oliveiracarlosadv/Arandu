{
  "name": "arandu",
  "private": true,
  "version": "0.1.0",
  "description": "ARANDU — processamento e conversão local de documentos para Markdown otimizado para IA.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/copy-assets.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "dompurify": "^3.5.0",
    "gpt-tokenizer": "^4.1.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.3.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tesseract.js-data/por": "^1.0.0",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2"
  }
}
